{
  "name": "@reneturcios/dsarguide",
  "version": "0.1.0",
  "description": "DSAR deadlines, breach notification clocks and triage, AI-tool DPIA checks, HR retention periods and letter templates, forwarded from the hosted Double AIgents DSAR service. One bin serves a small CLI and the MCP server.",
  "mcpName": "io.github.CloudCorpRecords/dsarguide",
